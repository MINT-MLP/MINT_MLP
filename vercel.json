{
  "outputDirectory": "dist",
  "regions": [
    "icn1"
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/session-create",
      "destination": "/api/session"
    },
    {
      "source": "/api/session-join",
      "destination": "/api/session"
    },
    {
      "source": "/api/session-get",
      "destination": "/api/session"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/admin/batch",
      "schedule": "0 18 * * *"
    }
  ]
}
